{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancestryllm.org/schemas/desktop-diagnostic-v1.schema.json",
  "title": "AncestryLLM privacy-safe desktop diagnostic event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "run_id",
    "code",
    "severity",
    "component",
    "app_version",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "ancestryllm.desktop-diagnostic/1"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "component": {
      "enum": [
        "electron-main",
        "python-core",
        "flask-sidecar"
      ]
    },
    "app_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          {
            "not": {
              "pattern": "(content|database|email|error|exception|family|gedcom|key|message|name|path|person|prompt|query|secret|stack|token|url)"
            }
          }
        ]
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "integer",
          "null"
        ],
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    }
  }
}
