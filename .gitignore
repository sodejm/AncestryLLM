# ---------------------------------------------------------------------------
# Secrets & private data  (NEVER commit these to a public repo)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Signing credentials and encoded key/certificate exports. Source material for
# the release helper must live outside the repository; these rules are a final
# guard against accidentally copying it into a checkout.
/secure/
/secrets/
*.p12
*.pfx
*.p8
*.pem
*.key
*.asc
*.gpg
*.b64
*.mobileprovision

# RootsMagic / genealogy databases are private personal data.
*.rmtree
*.rmgc
*.db
*.sqlite
*.sqlite3
*.ged
*.gedcom
*.bak
*.backup
*.report
*.sarif
sbom*.json
family_trees/*
!family_trees/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.tools/
node_modules/

# Test & coverage artifacts
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/
.dmypy.json

# ---------------------------------------------------------------------------
# OS & editor noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
logs/
node_modules
desktop/out/
desktop/coverage/
desktop/release/
desktop/release-file-grant-verification/
desktop/release-native-verification/
desktop/test-results/
desktop/playwright-report/
desktop/sbom.cdx.json
