{
  "schemaVersion": 1,
  "policyId": "ancestryllm-release-quality-v1",
  "families": {
    "qa": {
      "owner": "release-owner",
      "commands": [
        "make test",
        "make lint",
        "make typecheck",
        "pnpm --dir desktop run verify:source",
        "pnpm --dir desktop run test:coverage",
        "pnpm --dir desktop run test:accessibility",
        "pnpm --dir desktop run test:e2e",
        "pnpm --dir desktop run test:e2e:packaged"
      ]
    },
    "security": {
      "owner": "security-owner",
      "commands": [
        "make security",
        "make sbom",
        "pnpm --dir desktop run audit",
        "pnpm --dir desktop run check:secrets",
        "pnpm --dir desktop run sbom"
      ]
    },
    "performance": {
      "owner": "desktop-owner",
      "commands": [
        "pnpm --dir desktop run test:e2e:packaged"
      ]
    },
    "diagnostics": {
      "owner": "desktop-owner",
      "commands": [
        "make test",
        "pnpm --dir desktop run test:coverage"
      ]
    }
  },
  "evidence": {
    "inputs": [
      {
        "artifact": "release-evidence",
        "path": "gates.json"
      },
      {
        "artifact": "desktop-evidence-aggregate",
        "path": "desktop-evidence.json"
      }
    ],
    "approvalPath": "release-quality-approval.json",
    "verifier": "scripts/verify_release_quality.py"
  },
  "qa": {
    "readinessGates": [
      "bootstrap-verification",
      "codeql",
      "cross-platform-install",
      "cyclonedx-sbom",
      "dependency-audit",
      "lifecycle-audit",
      "mypy",
      "privacy-regressions",
      "project-release-gate",
      "repository-safety",
      "reproducible-distributions",
      "ruff-format",
      "secret-scan",
      "semgrep",
      "tests-and-coverage",
      "version-1-security-dependencies",
      "workflow-security-analysis"
    ],
    "toolVersions": {
      "python": "3.12",
      "node": "26.5.0",
      "pnpm": "11.9.0",
      "vitest": "3.2.7",
      "webdriverio": "9.31.2"
    },
    "desktopCoverage": {
      "provider": "v8",
      "thresholds": {
        "branches": 70,
        "functions": 75,
        "lines": 75,
        "statements": 75
      },
      "reviewedExclusions": [
        "e2e/**",
        "src/**/*.d.ts",
        "src/renderer/src/test-setup.ts"
      ]
    }
  },
  "security": {
    "desktopReceiptGates": [
      "runnerVersionsPassed",
      "desktopLintPassed",
      "desktopTypecheckPassed",
      "desktopCoveragePassed",
      "accessibilityPassed",
      "sourceWebdriverPassed",
      "diagnosticsContractPassed",
      "jsStaticAnalysisPassed",
      "auditPassed",
      "secretsPassed",
      "buildInspectionPassed",
      "apiContractPassed",
      "authBeforeParsingPassed",
      "domainRoutesAbsentPassed",
      "ipcSenderValidationPassed",
      "sidecarCompatibilityPassed",
      "sidecarIntegrityPassed",
      "providerNoneNetworkFreePassed",
      "redactionPassed",
      "sbomGeneratedPassed"
    ]
  },
  "performance": {
    "policyVersion": "desktop-unpacked-v1",
    "method": {
      "command": "pnpm --dir desktop run test:e2e:packaged",
      "measurementSource": "desktop/e2e/packaged-shell.wdio.ts",
      "validator": "desktop/scripts/verification-evidence.mjs",
      "packageBoundary": "unpacked-native"
    },
    "metrics": [
      "coldLaunchMs",
      "warmLaunchMs",
      "readyMs",
      "rssBytes",
      "rendererOutboundRequests"
    ],
    "targets": [
      {
        "runner": "macos-15",
        "sidecarTarget": "darwin-arm64",
        "expectedOs": "macOS 15",
        "arch": "arm64",
        "hostArch": "arm64",
        "performanceCeilings": {
          "coldLaunchMs": 30000,
          "warmLaunchMs": 20000,
          "readyMs": 45000,
          "rssBytes": 1610612736,
          "rendererOutboundRequests": 0
        }
      },
      {
