  "diagnostics": {
    "schemaVersion": "ancestryllm.desktop-diagnostic/1",
    "schemaPath": "schemas/desktop-diagnostic-v1.schema.json",
    "schemaSha256": "9cf0976dd5222ddd3fdb6f8bd777a0b05b6c64fe02ec8a33e7860d33e4c34d9c",
    "safeCodesSource": "schema properties.code.enum",
    "syntheticCanaryGate": "diagnosticsContractPassed",
    "retention": {
      "maxBytesPerFile": 524288,
      "maxFilesPerComponent": 3
    },
    "telemetry": false
  },
  "exceptions": []
