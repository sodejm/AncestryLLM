{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sodejm/AncestryLLM/config/docs-screenshot-manifest-v1.schema.json",
  "title": "AncestryLLM documentation screenshot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "launch_allowlist",
    "output_allowlist",
    "determinism",
    "fixtures",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "launch_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "output_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "determinism": {
      "$ref": "#/$defs/determinism"
    },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/fixture_descriptor"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "size_px",
        "weight",
        "source_policy"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "size_px": {
          "type": "integer",
          "minimum": 8,
          "maximum": 48
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100
        },
        "source_policy": {
          "const": "capture-adapter-bundled"
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "timezone",
        "theme",
        "fonts",
        "animations",
        "fixed_timestamp",
        "fixed_username",
        "path_policy",
        "id_seed",
        "volatile_data",
        "network"
      ],
      "properties": {
        "locale": {
          "const": "en_US.UTF-8"
        },
        "timezone": {
          "const": "UTC"
        },
        "theme": {
          "const": "light"
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "electron",
            "terminal"
          ],
          "properties": {
            "electron": {
              "$ref": "#/$defs/font"
            },
            "terminal": {
              "$ref": "#/$defs/font"
            }
          }
        },
        "animations": {
          "const": "disabled"
        },
        "fixed_timestamp": {
          "const": "2040-01-02T03:04:05Z"
        },
        "fixed_username": {
          "const": "Fictional Researcher"
        },
        "path_policy": {
          "const": "fixture-relative"
        },
        "id_seed": {
          "const": "ancestryllm-docs-v1"
        },
        "volatile_data": {
          "const": "fixture-only"
        },
        "network": {
          "const": "deny"
        }
      }
    },
    "fixture_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "path",
        "provider",
        "network",
        "fictional"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "state": {
          "enum": [
            "success",
            "degraded",
            "privacy-canary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "fictional": {
          "type": "boolean"
        }
      }
    },
    "viewport_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "width",
        "height",
        "device_scale_factor"
      ],
      "properties": {
        "kind": {
          "const": "viewport"
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 2160
        },
        "device_scale_factor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "terminal_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "terminal"
        },
        "columns": {
          "type": "integer",
          "minimum": 40,
          "maximum": 240
        },
        "rows": {
          "type": "integer",
          "minimum": 12,
          "maximum": 100
        }
      }
    },
    "documentation_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "ready_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "exact_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "exact"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "launch",
        "fixture_id",
        "geometry",
        "ready_signal",
        "output_path",
        "documentation",
        "comparison"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "surface": {
          "enum": [
            "electron",
            "terminal"
          ]
        },
        "launch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/viewport_geometry"
            },
            {
              "$ref": "#/$defs/terminal_geometry"
            }
          ]
        },
        "ready_signal": {
          "$ref": "#/$defs/ready_signal"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/documentation_reference"
          }
        },
        "comparison": {
          "$ref": "#/$defs/exact_comparison"
        }
      }
    }
  }
}
