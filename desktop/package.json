{
  "name": "ancestryllm-desktop",
  "version": "0.6.0",
  "description": "Local-first, privacy-preserving genealogy desktop application.",
  "homepage": "https://github.com/sodejm/AncestryLLM",
  "author": {
    "name": "Justin Soderberg",
    "email": "723679+sodejm@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.23.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:gallery": "electron-vite dev --mode gallery",
    "docs:check": "node scripts/check-code-documentation.mjs && eslint . --max-warnings=0",
    "lint": "pnpm docs:check",
    "typecheck": "tsc -p tsconfig.shared.json --pretty false && tsc -p tsconfig.main.json --pretty false && tsc -p tsconfig.preload.json --pretty false && tsc -p tsconfig.renderer.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "verify:source": "pnpm lint && pnpm typecheck",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage && node --test scripts/*.test.mjs",
    "test:accessibility": "vitest run src/renderer/src/design-system/Accessibility.test.tsx && pnpm build:e2e && node scripts/run-wdio.mjs source --grep 'automated WCAG checks'",
    "test:visual": "pnpm build:e2e && node scripts/run-wdio.mjs source --grep '200 percent zoom'",
    "test:native-container": "vitest run src/main/container-native-evidence.test.ts",
    "build": "pnpm typecheck && electron-vite build && node scripts/verify-build.mjs",
    "build:e2e": "pnpm typecheck && electron-vite build && node scripts/verify-build.mjs --fixture",
    "capture:docs": "pnpm build:e2e && playwright test e2e/docs-screenshots.spec.ts",
    "build:packaged-native-verification": "pnpm typecheck && electron-vite build && node scripts/verify-build.mjs --packaged-native-verification",
    "build:packaged-file-grants": "pnpm typecheck && electron-vite build && node scripts/verify-build.mjs --packaged-native-verification --packaged-file-grants",
    "test:e2e": "pnpm build:e2e && node scripts/run-wdio.mjs source",
    "test:e2e:headless": "pnpm build:e2e && node scripts/run-wdio.mjs source --headless",
    "test:e2e:packaged": "node scripts/run-wdio.mjs packaged",
    "audit": "pnpm audit --audit-level high",
    "check:secrets": "node scripts/check-secrets.mjs",
    "sbom": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.6 --sbom-type application --out sbom.cdx.json",
    "security": "pnpm audit --audit-level high && pnpm check:secrets && pnpm run sbom",
    "package": "node scripts/verify-sidecar.mjs && pnpm build && node scripts/run-electron-builder.mjs --dir",
    "inspect:fuses": "node scripts/inspect-package-fuses.mjs",
    "test:security": "pnpm package && vitest run src/main/security-policy.test.ts src/main/session-policy.test.ts src/main/external-links.test.ts && node scripts/inspect-package-fuses.mjs"
  },
  "build": {
    "appId": "org.ancestryllm.desktop",
    "productName": "AncestryLLM",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar",
        "to": "sidecar"
      },
      {
        "from": "resources/macos-arm64-runtime-policy-v1.json",
        "to": "runtime-policy/macos-arm64-runtime-policy-v1.json"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "identity": null,
      "forceCodeSigning": false,
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "signAndEditExecutable": true,
      "signExecutable": false,
      "forceCodeSigning": false
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@wdio/cli": "10.2.0",
    "@wdio/electron-service": "10.4.1",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/native-types": "2.6.1",
    "@wdio/spec-reporter": "10.2.0",
    "ajv": "8.20.0",
    "axe-core": "4.14.1",
    "corepack": "0.36.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.5.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "expect-webdriverio": "8.1.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "webdriverio": "10.2.0"
  }
}
